{
  // ATTENTION : CE FICHIER PUBLIE LA PRODUCTION.
  // `wrangler deploy` lance depuis hosting/ met a jour le worker `www`, donc
  // recblue.net et www.recblue.net. C'est voulu : le mauvais worker etait celui
  // qu'on publiait par accident.
  // Le worker de DEVELOPPEMENT (`rec-blue-local`) vit dans wrangler-local.jsonc
  // et se deploie avec : wrangler deploy --config wrangler-local.jsonc
  "name": "www",
  "main": "worker.js",
  "compatibility_date": "2025-10-11",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "routes": [
    { "pattern": "recblue.net", "custom_domain": true },
    { "pattern": "www.recblue.net", "custom_domain": true }
  ]
}
